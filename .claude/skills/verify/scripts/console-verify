#!/usr/bin/env bash
# Drive Craft Console in the running app. See ../SKILL.md.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
run="${CONSOLE_VERIFY_RUN:?set CONSOLE_VERIFY_RUN to a run id, such as \$(date +%Y%m%d-%H%M%S)}"
state=".verify/$run"
here=".claude/skills/verify/scripts"

free_port() {
  node -e 'const s=require("net").createServer();s.listen(0,()=>{console.log(s.address().port);s.close()})'
}

case "${1:-}" in
  launch)
    [[ -f "$state/pid" ]] && kill -0 "$(cat "$state/pid")" 2>/dev/null && {
      echo "run $run already has an instance on port $(cat "$state/port")" >&2
      exit 1
    }
    mkdir -p "$state"
    pnpm install --frozen-lockfile
    pnpm build
    port="${CONSOLE_VERIFY_PORT:-$(free_port)}"
    echo "$port" > "$state/port"
    CONSOLE_DATA=fixtures PORT="$port" setsid pnpm start > "$state/server.log" 2>&1 &
    echo $! > "$state/pid"
    for _ in $(seq 1 60); do
      if [[ "$(curl -fsS "http://127.0.0.1:$port/api/health" 2>/dev/null)" == ok ]]; then
        echo "ready: http://127.0.0.1:$port run=$run"
        exit 0
      fi
      kill -0 "$(cat "$state/pid")" 2>/dev/null || break
      sleep 1
    done
    echo "the app did not answer /api/health with ok in 60 seconds" >&2
    cat "$state/server.log" >&2
    exit 1
    ;;
  drive)
    port="$(cat "$state/port")"
    node "$here/drive.mjs" "http://127.0.0.1:$port" "$state/evidence"
    node "$here/states.mjs" "$state/evidence"
    ;;
  live)
    # A fresh app on live data, so its first Projects request makes a fresh read.
    mkdir -p "$state"
    port="$(free_port)"
    CONSOLE_DATA=live NODE_USE_ENV_PROXY=1 PORT="$port" setsid pnpm start > "$state/live-server.log" 2>&1 &
    pid=$!
    trap 'kill -- -"$pid" 2>/dev/null || true' EXIT
    for _ in $(seq 1 60); do
      [[ "$(curl -fsS "http://127.0.0.1:$port/api/health" 2>/dev/null)" == ok ]] && break
      sleep 1
    done
    NODE_USE_ENV_PROXY=1 node "$here/live.mjs" "http://127.0.0.1:$port" "$state/evidence"
    ;;
  cleanup)
    if [[ -f "$state/pid" ]]; then
      kill -- -"$(cat "$state/pid")" 2>/dev/null || true
      rm -f "$state/pid"
    fi
    echo "stopped run $run"
    ;;
  *)
    echo "usage: console-verify launch|drive|live|cleanup" >&2
    exit 2
    ;;
esac
